content pertains to computer science. Do not write a code block with a single line of code. Try to group related code blocks together.\n2. Headings, lists, tables and code blocks must be preceeded and followed by an empty line (\n).\n3. Do NOT include tables or code blocks inside lists.\n4. List must contain at least two items.\n5. Do not include a title (# or h1). All headings must start as an h2 or lower following a11y best practices.\n6. Do not generate any additional content. While minor grammar and puncation changes are fine, your primary goal is to improve the layout of the existing content. Avoid the urge to improve the source material beyond the scope of its format or layout.\n7. Do not get overzealous with formatting improvements. The markdown should improve the flow of the content, but not distract from the original source material.\n8. You must retain as much of the original source material as possible.",generating:!0,temperature:.1,anchorEl:null,children:[]},{mode:"highest"}),fe.a.addMark(oe,"selected",!0),fe.j.collapse(oe,{edge:"end"}),fe.a.removeMark(oe,"selected")})},[oe,se,Oe,Ee]),we=Object(ve.f)("view_button",{button:{name:"writing_assistant_auto_layout"}}),_e=useAILayoutState_useAILayoutState(),Ie=_e.active,Pe=_e.disabled;return ue.createElement(ai_layout_AILayoutDiscoveryTooltip,{show:!Se&&!Pe,onDismiss:function(){return Oe(!0)}},ue.createElement(ge.a,{ref:we,onClick:Ce,active:Ie,title:xe()("Auto-layout"),disabled:Pe,type:be.a.insertion},ae||(ae=ue.createElement(ai_layout_AILayoutIcon,{height:"16px",width:"16px"}))))},qt=a("QjcJ"),Vt=a("N2Jo"),Ht=a("MHnd"),Wt=a("cVL0"),$t=a("Uaxt"),Kt=a("dhC9"),Qt=Object($t.isHotkey)("return"),Yt={textField:Object(Ee.c)(Ge||(Ge=Oe()(["\n    .cds-text-field-root {\n      margin-top: 0;\n    }\n  "])))},ai_CustomPromptMenuItem=function(i){var a=i.className,U=i.onChange,J=Object(ue.useState)(""),ee=le()(J,2),te=ee[0],re=ee[1],ie=Object(ue.useRef)(null),ae=Object(ve.e)(),oe=Object(ue.useCallback)(function(i){re(i.targ