# AI & OCR Cloud Provider Keys & Automatic Fallback
AI_FALLBACK_ENABLED=true
PROVIDER_COOLDOWN_SECONDS=60
OCR_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MODELS=qwen/qwen3.8-27b,qwen/qwen3.6-27b

# Application Environment
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:5173

# GTIN Product Identity Provider
GTIN_PROVIDER=OPEN_FOOD_FACTS
